# Static Astro host configuration. Leave these empty for localhost:5101-5107.
# For GitHub Pages or a tunnel, use complete browser-reachable HTTPS URLs.
PUBLIC_SITE=https://YOUR-USER.github.io/YOUR-REPOSITORY
PUBLIC_BASE=/YOUR-REPOSITORY
PUBLIC_PROVIDER_REACT_URL=
PUBLIC_PROVIDER_SVELTE_URL=
PUBLIC_PROVIDER_RSC_URL=
PUBLIC_PROVIDER_SVELTE_SSR_URL=
PUBLIC_PROVIDER_HONO_URL=
PUBLIC_PROVIDER_NEXT_URL=
PUBLIC_PROVIDER_BLAZOR_URL=
PUBLIC_PROVIDER_PHOENIX_URL=

# This is the scheme + host + port origin allowed by provider CORS and websocket checks.
HOST_ORIGIN=https://YOUR-USER.github.io

# Used by Phoenix in compose. Replace the demo value outside local testing.
PHOENIX_SECRET_KEY_BASE=replace-with-a-long-random-secret
