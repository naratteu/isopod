---
interface Props { src: string; provider: string; scope: 'local' | 'global'; entry?: string }
const { src, provider, scope, entry = 'remote.js' } = Astro.props;
---
<remote-island data-src={src} data-provider={provider} data-counter-scope={scope}>
  <p data-status role="status">공급자에 연결하는 중…</p>
  <div data-root></div>
</remote-island>
