---
import RemoteProvider from '../../remote-renderer/provider.js';
import '../styles.css';
const providerHost = import.meta.env.PUBLIC_PROVIDER_HOST || 'localhost';
const assetBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const providerUrl = (specific, port) => specific || `http://${providerHost}:${port}`;
const providers = [
  { id: 'react', label: 'React', kind: 'CLIENT', scope: 'local', port: 5101, url: import.meta.env.PUBLIC_PROVIDER_REACT_URL },
  { id: 'svelte', label: 'Svelte', kind: 'CLIENT', scope: 'local', port: 5102, url: import.meta.env.PUBLIC_PROVIDER_SVELTE_URL },
  { id: 'rsc', label: 'React Server Component', kind: 'SERVER · NEXT', scope: 'local', port: 5105, url: import.meta.env.PUBLIC_PROVIDER_RSC_URL },
  { id: 'svelte-ssr', label: 'Svelte SSR', kind: 'SERVER · HTML', scope: 'global', port: 5104, url: import.meta.env.PUBLIC_PROVIDER_SVELTE_SSR_URL },
  { id: 'hono', label: 'Hono', kind: 'SERVER · HTML', scope: 'global', port: 5103, url: import.meta.env.PUBLIC_PROVIDER_HONO_URL },
  { id: 'next', label: 'Next.js', kind: 'REMOTE CLIENT', scope: 'local', port: 5105, url: import.meta.env.PUBLIC_PROVIDER_NEXT_URL, entry: 'client.js' },
  { id: 'blazor', label: 'Blazor Server', kind: 'SERVER · C#', scope: 'global', port: 5106, url: import.meta.env.PUBLIC_PROVIDER_BLAZOR_URL },
  { id: 'phoenix', label: 'Phoenix LiveView', kind: 'SERVER · ELIXIR', scope: 'global', port: 5107, url: import.meta.env.PUBLIC_PROVIDER_PHOENIX_URL },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="하나의 정적 Astro 페이지, 서로 다른 일곱 공급자, 여덟 개의 살아 있는 컴포넌트." />
    <title>Isopod — 한 페이지, 여러 세계</title>
    <script is:inline>
      (() => {
        const valid = value => /^https?:\/\/[^\s]+$/i.test(value || '');
        const params = new URLSearchParams(location.search);
        const config = JSON.parse(localStorage.getItem('isopod.provider-urls') || '{}');
        for (const id of ['react', 'svelte', 'rsc', 'svelte-ssr', 'hono', 'next', 'blazor', 'phoenix']) {
          const value = params.get(id);
          if (valid(value)) config[id] = value.replace(/\/$/, '');
        }
        window.isopodProviderUrls = config;
      })();
    </script>
    <script is:inline type="module" src={`${assetBase}/remote-island.js`}></script>
  </head>
  <body>
    <header class="masthead"><a href="/" aria-label="Isopod 홈">◉ ISOPOD</a><span>MICROFRONTEND FIELD NOTES / 001</span></header>
    <main>
      <section class="intro">
        <p class="eyebrow">INDEPENDENT INSIDE. TOGETHER OUTSIDE.</p>
        <h1>한 페이지,<br /><em>여러 세계.</em></h1>
        <div class="intro-bottom">
          <p>각자의 언어로 움직이고, 하나의 디자인으로 만납니다.<br />일곱 공급자와 여덟 컴포넌트. 이 페이지는 정적입니다.</p>
          <fieldset class="themes">
            <legend>같은 HTML, 다른 CSS</legend>
            <label><input type="radio" name="theme" id="theme-garden" checked /> Garden</label>
            <label><input type="radio" name="theme" id="theme-paper" /> Paper</label>
            <label><input type="radio" name="theme" id="theme-night" /> Night</label>
          </fieldset>
        </div>
      </section>
      <section class="quickstart" aria-label="로컬 실행 안내">
        <div><p class="eyebrow">START HERE</p><h2>로컬에서 바로 실행</h2><p>터미널에 아래 명령을 붙여 넣고 <a href="http://localhost:4321">localhost:4321</a>을 여세요.</p></div>
        <code>git clone https://github.com/naratteu/isopod.git && cd isopod && docker compose up --build -d</code>
        <button type="button" data-copy-local>명령 복사</button><span data-quickstart-status role="status"></span>
      </section>
      <details class="connection-panel">
        <summary>다른 기기에서 연결하기 (선택) <span>Cloudflare Tunnel 등의 공개 URL을 사용할 때만 엽니다 ↗</span></summary>
        <form data-provider-config>
          <p class="config-help">로컬 실행이 먼저입니다. 외부에서 보려는 경우에만 Cloudflare Tunnel을 실행하고, 아래 명령을 복사하세요.</p>
          <div class="config-actions"><button type="button" data-copy-cloudflare>Cloudflare 명령 복사</button></div>
          <div class="config-grid">
            {providers.map(provider => (
              <label><span>{provider.label}</span><input name={provider.id} data-provider-url={provider.id} placeholder={`https://... (${provider.port})`} /></label>
            ))}
          </div>
          <div class="config-actions">
            <button type="submit">이 페이지에 적용</button>
            <button type="button" data-clear-provider>초기화</button>
          </div>
          <textarea data-command-output readonly aria-label="복사할 명령"></textarea>
          <p data-config-status role="status"></p>
        </form>
      </details>
      <p class="scope-note"><b>LOCAL</b> 브라우저 상태 · <strong>GLOBAL</strong> 공급자 프로세스 상태</p>
      <section class="collection" aria-label="컴포넌트 정원">
        {providers.map((provider, index) => (
          <section class:list={['island-card', provider.scope === 'global' && 'global-card']} data-provider={provider.id} data-scope={provider.scope} aria-label={provider.label}>
            <header class="card-label"><span>{String(index + 1).padStart(2, '0')}</span><span>{provider.kind}</span></header>
            <RemoteProvider client:only="isopod" provider={provider.id} scope={provider.scope} entry={provider.entry} src={`${providerUrl(provider.url, provider.port)}/${provider.entry || 'remote.js'}`} />
            <footer class="card-footer"><span>{provider.url || `:${provider.port}`}</span><span data-counter-label>{provider.scope === 'global' ? 'GLOBAL' : 'LOCAL'}</span><button type="button" data-toggle-island>연결 해제</button></footer>
          </section>
        ))}
      </section>
      <aside class="note"><span>직접 해보세요 ↗</span><p>숫자를 올리고 테마를 바꿔 보세요. 모습이 바뀌어도 상태와 서버 시각은 이어집니다. 연결을 해제하면 해당 컴포넌트만 멈춥니다.</p></aside>
    </main>
    <footer class="page-footer"><span>ASTRO ISLANDS + NATIVE CSS</span><span><a href={`${assetBase}/web-components/`}>Web Components PoC 보기 ↗</a></span></footer>
    <noscript>컴포넌트 공급자에 연결하려면 JavaScript를 활성화해 주세요.</noscript>
  </body>
</html>
